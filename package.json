{
  "name": "enjoyspace-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:cloudflare": "vite build --mode cloudflare",
