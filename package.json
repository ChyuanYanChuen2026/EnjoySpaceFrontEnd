    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.9",
    "wrangler": "4.156.1"
  }
}
